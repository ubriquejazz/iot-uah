                "0187d87deee2a4f6"
            ]
        ]
    },
    {
        "id": "func_split",
        "type": "function",
        "z": "tab_magneto",
        "name": "Procesar X,Y,Z",
        "func": "var uuid = \"e95dfb11251d470aa062fa1922dfa9a8\";\nvar buf = msg.payload.characteristics[uuid];\n\nif (buf && buf.length >= 6) {\n    // El micro:bit envía 2 bytes por eje (Little Endian, Signed)\n    var x = buf.readInt16LE(0);\n    var y = buf.readInt16LE(2);\n    var z = buf.readInt16LE(4);\n\n    // Enviamos tres mensajes distintos, uno para cada línea del gráfico\n    return [\n        { payload: x, topic: \"Eje X\" },\n        { payload: y, topic: \"Eje Y\" },\n        { payload: z, topic: \"Eje Z\" }\n    ];\n}\nreturn null;",
        "outputs": 3,
        "x": 380,
        "y": 340,
        "wires": [
            [
                "chart_node"
            ],
            [
                "chart_node"
            ],
            [
                "chart_node"
            ]
        ]
    },
