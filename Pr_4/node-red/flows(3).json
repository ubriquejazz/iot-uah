        "type": "function",
        "z": "tab_termo",
        "name": "Convert Temp",
        "func": "// The generic-ble node outputs an object.\n// We look for the Temperature Characteristic UUID.\nvar uuid = \"e95d9250251d470aa062fa1922dfa9a8\";\nvar data = msg.payload.characteristics[uuid];\n\nif (data && Buffer.isBuffer(data)) {\n    // Temperature is a signed 8-bit integer (Int8)\n    msg.payload = data.readInt8(0);\n    msg.unit = \"°C\";\n    return msg;\n}",
