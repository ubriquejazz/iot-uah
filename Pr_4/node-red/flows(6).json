    {
        "id": "e5d720d27860b8d3",
        "type": "function",
        "z": "79d6609901cb66ba",
        "name": "Set Mask",
        "func": "// Máscara para pines 0, 1 y 2 en binario: 00000111 (7 en decimal)\n// Esto le dice al micro:bit que P0, P1 y P2 son digitales.\nmsg.payload = Buffer.from([7]); \nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 300,
        "wires": [
            [
                "3d4986eb5c5ec6ef"
            ]
        ]
    },
    {
