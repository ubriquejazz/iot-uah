                "3d4986eb5c5ec6ef"
            ]
        ]
    },
    {
        "id": "0d268a970bd4a1af",
        "type": "function",
        "z": "79d6609901cb66ba",
        "name": "Extraer P0, P1, P2",
        "func": "var uuid = \"e95d8d00251d470aa062fa1922dfa9a8\";\nvar data = msg.payload.characteristics[uuid];\n\nif (data && Buffer.isBuffer(data)) {\n    var pinValues = data[0]; // El primer byte contiene el estado de los pines\n    \n    // Extraemos los bits individuales\n    var p0 = (pinValues & 1) ? true : false;\n    var p1 = (pinValues & 2) ? true : false;\n    var p2 = (pinValues & 4) ? true : false;\n\n    return [\n        { payload: p0 },\n        { payload: p1 },\n        { payload: p2 }\n    ];\n}\nreturn null;",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 380,
        "wires": [
