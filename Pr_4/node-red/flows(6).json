                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "4",
        "topic": "e95d8d00-251d-470a-a062-fa1922dfa9a8",
        "payload": "subscribe",
        "payloadType": "str",
        "x": 150,
        "y": 380,
        "wires": [
